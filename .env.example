# Supabase
# NOTE: these are placeholders only. Do not commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (server-only — never prefix with NEXT_PUBLIC_)
# AI_PROVIDER selects the generation provider only — embeddings always use
# Cloudflare regardless of this value. Supported values: "gemini", "openai",
# "cloudflare".
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional — defaults to gemini-3.6-flash if unset. Override when a specific
# model's free-tier quota is exhausted (confirmed live: 20 requests/day/model).
GEMINI_MODEL=

# Only required when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cloudflare — required for embeddings always; required for generation only
# when AI_PROVIDER=cloudflare.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
