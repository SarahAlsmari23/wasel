# Supabase
# NOTE: these are placeholders only. Do not commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (server-only — never prefix with NEXT_PUBLIC_) ──────────────────────
#
# Primary conversational model: Meta Llama on Cloudflare Workers AI, using the
# same Cloudflare account that already serves embeddings. Llama 4 Scout is the
# default, with Llama 3.3 70B as an automatic fallback model.
#
# AI_PRIMARY_PROVIDER   llama | gemini | openai   (default: llama)
# AI_FALLBACK_PROVIDER  llama | gemini | openai   (default: none)
# The legacy AI_PROVIDER variable is no longer read for generation.
AI_PRIMARY_PROVIDER=llama
AI_FALLBACK_PROVIDER=

# Cloudflare — required (generation via Llama, and embeddings for retrieval).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional model overrides (defaults shown). Set LLAMA_FALLBACK_MODEL=none to
# disable the fallback model.
# LLAMA_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# LLAMA_FALLBACK_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Optional alternatives (only when selected above).
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Rate limiting (optional, recommended in production) ────────────────────
# A Redis-compatible REST store shared by every serverless instance. Either
# Upstash or Vercel KV variables work. Without them, a per-instance in-memory
# limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Diagnostics (optional) ─────────────────────────────────────────────────
# Verbose, structural-only chat pipeline tracing. Never logs message content.
CHAT_DEBUG_LOGS=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
